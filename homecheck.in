<a class="wa" href="https://wa.me/919701172777?text=Hi%2C+I%27d+like+to+book+a+home+inspection+in+Hyderabad" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="white"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

<script>
/* ── SCROLL REVEAL ── */
const revealEls = document.querySelectorAll('.reveal');
new IntersectionObserver((entries) => {
  entries.forEach(e => {
    if (e.isIntersecting) { e.target.classList.add('in'); }
  });
}, { threshold: 0.1 }).observe && revealEls.forEach(el =>
  new IntersectionObserver((entries) => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('in'); });
  }, { threshold: 0.1 }).observe(el)
);

/* ── FAQ ── */
function toggleFaq(el) {
  const item = el.parentElement;
  const open = item.classList.contains('open');
  document.querySelectorAll('.faq-item').forEach(i => {
    i.classList.remove('open');
    i.querySelector('.faq-q').setAttribute('aria-expanded','false');
  });
  if (!open) { item.classList.add('open'); el.setAttribute('aria-expanded','true'); }
}
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('keydown', e => { if (e.key==='Enter'||e.key===' ') { e.preventDefault(); toggleFaq(q); } });
});

/* ── AI CHAT ── */
const SYS = `You are HomeCheck AI, the intelligent assistant for HomeCheck.in — Hyderabad's first and most trusted home inspection company, established in 2016.

Key information:
- Address: Buckingham Apartments, Road No. 12, Banjara Hills, Hyderabad 500034
- Phones: +91 9701 172 777 | +91 9701 685 777 | +91 9866 935 578
- Email: contact@homecheck.in | Website: homecheck.in
- Services: Pre-Handover Comprehensive Inspection, Multi-Stage Property Inspection, Thermographic & Seepage Inspection (infrared), Area Measurement Inspection, Re-Inspection, Rental/Handover Inspection
- Team: Certified B.E./B.Tech civil engineers
- Checklist: 250+ inspection points
- Report delivery: Within 48 hours, detailed PDF with photographs
- Independence: 100% builder-independent — we work only for the buyer
- Areas covered: Gachibowli, Kondapur, Miyapur, Kokapet, HITEC City, Financial District, Tellapur, Banjara Hills, Jubilee Hills, Madhapur, Kukatpally, Bachupally, Narsingi, Shamshabad, Manikonda

Be warm, professional, and concise (2–4 sentences). Always guide users to book at homecheck.in/request-for-home-check/ or call for specific pricing quotes.`;

const msgsEl = document.getElementById('chatMsgs');
const inputEl = document.getElementById('chatIn');
const btnEl = document.getElementById('chatSendBtn');
let history = [];

function addBubble(text, cls) {
  const d = document.createElement('div');
  d.className = 'm ' + cls; d.textContent = text;
  msgsEl.appendChild(d); msgsEl.scrollTop = msgsEl.scrollHeight;
  return d;
}

async function doSend() {
  const txt = inputEl.value.trim();
  if (!txt) return;
  inputEl.value = ''; btnEl.disabled = true;
  addBubble(txt, 'usr');
  history.push({ role: 'user', content: txt });
  const t = addBubble('Typing…', 'bot typing');
  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: 'claude-sonnet-4-20250514',
        max_tokens: 1000,
        system: SYS,
        messages: history
      })
    });
    const data = await res.json();
    const reply = data.content?.[0]?.text || 'Sorry, please call us at +91 9701 172 777.';
    t.remove(); addBubble(reply, 'bot');
    history.push({ role: 'assistant', content: reply });
  } catch {
    t.remove(); addBubble('Having trouble right now. Please call +91 9701 172 777 or visit homecheck.in.', 'bot');
  }
  btnEl.disabled = false; inputEl.focus();
}

function quickSend(el) { inputEl.value = el.textContent; doSend(); }
inputEl.addEventListener('keydown', e => { if (e.key === 'Enter') doSend(); });
</script>
</body>
</html>
