<!-- ══ STATS ══ -->
<div class="stats-band" role="region" aria-label="Key statistics">
  <div class="stat-cell">
    <div class="stat-num">8<sup>+</sup></div>
    <div class="stat-name">Years Experience</div>
  </div>
  <div class="stat-cell">
    <div class="stat-num">1K<sup>+</sup></div>
    <div class="stat-name">Happy Clients</div>
  </div>
