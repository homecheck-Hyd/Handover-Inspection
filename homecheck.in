  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400&display=swap" rel="stylesheet" />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      /* ── EXACT BRAND COLORS FROM LOGO IMAGE ── */
      --navy:       #1B2E5E;   /* HOME text navy */
      --navy-dark:  #0D1B3E;   /* background strip */
      --navy-deeper:#0A1428;
      --red:        #E8192C;   /* CHECK red */
      --red-dark:   #C4101F;
      --blue:       #1B6FE8;   /* accent circles */
      --blue-dark:  #1458C4;
      --blue-light: #3B82F6;
      --white:      #FFFFFF;
      --off-white:  #F5F7FF;
      --light-gray: #EEF1F8;
      --mid-gray:   #8B95AE;
      --dark-text:  #0F1D3A;
      /* Semantic */
      --bg-page:    #FFFFFF;
      --bg-section: #F5F7FF;
      --bg-dark:    #0D1B3E;
      --border-light: rgba(27,46,94,0.10);
      --border-mid:   rgba(27,111,232,0.18);
      --shadow-sm:  0 2px 12px rgba(27,46,94,0.08);
      --shadow-md:  0 8px 32px rgba(27,46,94,0.14);
      --shadow-lg:  0 20px 60px rgba(27,46,94,0.18);
    }

    html { scroll-behavior: smooth; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: var(--bg-page);
      color: var(--dark-text);
      overflow-x: hidden;
      line-height: 1.6;
      font-size: 15px;
    }

    /* ═══ TOPBAR ═══ */
    .topbar {
      background: var(--navy-dark);
      padding: 9px 5%;
      display: flex; align-items: center; justify-content: space-between;
      flex-wrap: wrap; gap: 6px;
    }
    .topbar-left, .topbar-right { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
    .topbar a, .topbar span {
      color: rgba(255,255,255,0.75); text-decoration: none;
      font-size: 0.72rem; font-weight: 500; letter-spacing: 0.02em;
      display: flex; align-items: center; gap: 5px;
      transition: color 0.2s;
    }
    .topbar a:hover { color: #fff; }
    .topbar-sep { width: 1px; height: 12px; background: rgba(255,255,255,0.2); }

    /* ═══ NAV ═══ */
    nav {
      position: sticky; top: 0; z-index: 500;
      background: var(--white);
      border-bottom: 1px solid var(--border-light);
      box-shadow: var(--shadow-sm);
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 5%;
      height: 70px;
    }

    .nav-brand {
      display: flex; align-items: center; gap: 11px;
      text-decoration: none;
    }
    .brand-icon {
      width: 40px; height: 40px; border-radius: 9px;
      background: var(--navy);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.1rem; flex-shrink: 0;
    }
    .brand-wordmark {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800; font-size: 1.35rem; line-height: 1;
      letter-spacing: -0.02em;
    }
    .brand-wordmark .w-home { color: var(--navy); }
    .brand-wordmark .w-check { color: var(--red); }
    .brand-wordmark .w-in { color: var(--navy); }
    .brand-tagline { font-size: 0.58rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid-gray); margin-top: 3px; }

    .nav-menu { display: flex; align-items: center; gap: 2px; list-style: none; }
    .nav-menu a {
      padding: 8px 13px; border-radius: 6px;
      color: var(--navy); font-size: 0.83rem; font-weight: 600;
      text-decoration: none; transition: all 0.2s;
    }
    .nav-menu a:hover { background: var(--off-white); color: var(--blue); }

    .nav-actions { display: flex; align-items: center; gap: 10px; }
    .nav-phone {
      display: flex; align-items: center; gap: 6px;
      color: var(--navy); font-size: 0.8rem; font-weight: 700;
      text-decoration: none; padding: 8px 14px;
      border: 1.5px solid var(--border-light);
      border-radius: 7px; transition: all 0.2s;
    }
    .nav-phone:hover { border-color: var(--blue); color: var(--blue); }
    .nav-book {
      background: var(--red); color: var(--white);
      padding: 9px 20px; border-radius: 7px;
      font-weight: 700; font-size: 0.8rem; letter-spacing: 0.03em;
      text-decoration: none; text-transform: uppercase;
      transition: all 0.25s; white-space: nowrap;
    }
    .nav-book:hover { background: var(--red-dark); box-shadow: 0 6px 18px rgba(232,25,44,0.35); transform: translateY(-1px); }

    /* ═══ HERO ═══ */
    .hero {
      position: relative;
      background: var(--navy-dark);
      min-height: 88vh;
      display: grid; grid-template-columns: 1fr 1fr;
      overflow: hidden;
    }

    /* Subtle geometric mesh on dark bg */
    .hero::before {
      content: '';
      position: absolute; inset: 0; pointer-events: none;
      background-image:
        radial-gradient(circle at 20% 50%, rgba(27,111,232,0.12) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(232,25,44,0.08) 0%, transparent 40%),
        repeating-linear-gradient(60deg, rgba(27,111,232,0.03) 0, rgba(27,111,232,0.03) 1px, transparent 1px, transparent 48px);
    }

    .hero-content {
      position: relative; z-index: 2;
      display: flex; flex-direction: column; justify-content: center;
      padding: 80px 5% 80px 7%;
    }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(232,25,44,0.15);
      border: 1px solid rgba(232,25,44,0.4);
      color: #FF6070; padding: 7px 15px; border-radius: 4px;
      font-size: 0.68rem; font-weight: 800; letter-spacing: 0.1em;
      text-transform: uppercase; width: fit-content; margin-bottom: 24px;
      animation: fadeUp 0.7s 0.1s ease both;
    }
    .badge-blink { width: 6px; height: 6px; border-radius: 50%; background: var(--red); animation: blink 1.8s infinite; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }

    .hero h1 {
      font-family: 'Fraunces', serif;
      font-size: clamp(2.5rem, 4.5vw, 4rem);
      font-weight: 900; line-height: 1.1;
      color: var(--white); letter-spacing: -0.02em;
      animation: fadeUp 0.7s 0.25s ease both;
    }
    .hero h1 .hl-red { color: var(--red); }
    .hero h1 .hl-blue { color: #5EA8FF; }

    .hero-desc {
      margin-top: 20px; color: rgba(255,255,255,0.65);
      font-size: 0.95rem; line-height: 1.8; max-width: 480px;
      animation: fadeUp 0.7s 0.4s ease both;
    }

    .hero-ctas {
      display: flex; gap: 12px; flex-wrap: wrap;
      margin-top: 34px;
      animation: fadeUp 0.7s 0.55s ease both;
    }
    .cta-primary {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--red); color: var(--white);
      padding: 14px 28px; border-radius: 7px;
      font-weight: 800; font-size: 0.88rem; letter-spacing: 0.04em;
      text-transform: uppercase; text-decoration: none;
      transition: all 0.25s; border: none; cursor: pointer;
    }
    .cta-primary:hover { background: var(--red-dark); transform: translateY(-2px); box-shadow: 0 12px 30px rgba(232,25,44,0.4); }
    .cta-secondary {
      display: inline-flex; align-items: center; gap: 8px;
      background: rgba(255,255,255,0.08);
      border: 1.5px solid rgba(255,255,255,0.22);
      color: var(--white); padding: 14px 28px; border-radius: 7px;
      font-weight: 700; font-size: 0.88rem;
      text-decoration: none; transition: all 0.25s;
    }
    .cta-secondary:hover { background: rgba(255,255,255,0.14); border-color: rgba(255,255,255,0.4); }

    .hero-chips {
      display: flex; gap: 10px; flex-wrap: wrap; margin-top: 36px;
      animation: fadeUp 0.7s 0.7s ease both;
    }
    .chip {
      display: flex; align-items: center; gap: 6px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.65); padding: 6px 12px; border-radius: 4px;
      font-size: 0.71rem; font-weight: 600; letter-spacing: 0.04em;
    }
    .chip-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ADE80; }

    /* Hero right — visual panel */
    .hero-visual {
      position: relative; z-index: 2;
      display: flex; align-items: center; justify-content: center;
      padding: 40px 5% 40px 0;
      animation: fadeUp 0.7s 0.3s ease both;
    }

    .hero-card-stack {
      position: relative; width: 100%; max-width: 420px;
    }
    .hcard {
      background: var(--white);
      border-radius: 16px; overflow: hidden;
      box-shadow: 0 24px 60px rgba(0,0,0,0.35);
    }
    .hcard-header {
      background: var(--navy);
      padding: 18px 22px;
      display: flex; align-items: center; justify-content: space-between;
    }
    .hcard-title { color: var(--white); font-weight: 700; font-size: 0.85rem; }
    .hcard-badge {
      background: var(--red); color: var(--white);
      padding: 3px 10px; border-radius: 100px;
      font-size: 0.65rem; font-weight: 800; letter-spacing: 0.06em;
    }
    .hcard-body { padding: 20px 22px; }
    .hcard-row {
      display: flex; align-items: center; gap: 12px;
      padding: 10px 0; border-bottom: 1px solid var(--border-light);
    }
    .hcard-row:last-child { border-bottom: none; }
    .hcard-icon {
      width: 36px; height: 36px; border-radius: 8px;
      background: var(--off-white); flex-shrink: 0;
      display: flex; align-items: center; justify-content: center; font-size: 0.9rem;
    }
    .hcard-label { font-size: 0.8rem; color: var(--dark-text); font-weight: 600; }
    .hcard-status {
      margin-left: auto; font-size: 0.65rem; font-weight: 700;
      letter-spacing: 0.06em; text-transform: uppercase;
      padding: 3px 8px; border-radius: 4px;
    }
    .status-ok { background: rgba(74,222,128,0.12); color: #16A34A; }
    .status-warn { background: rgba(232,25,44,0.1); color: var(--red); }
    .status-check { background: rgba(27,111,232,0.1); color: var(--blue); }

    /* Floating stat cards */
    .float-stat {
      position: absolute;
      background: var(--white); border-radius: 10px;
      padding: 12px 16px;
      box-shadow: 0 12px 36px rgba(0,0,0,0.25);
      display: flex; align-items: center; gap: 10px;
    }
    .float-stat.f1 { top: -18px; right: -18px; animation: float1 4s ease-in-out infinite; }
    .float-stat.f2 { bottom: -18px; left: -18px; animation: float2 5s ease-in-out infinite; }
    @keyframes float1 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
    @keyframes float2 { 0%,100%{transform:translateY(0)} 50%{transform:translateY(8px)} }

    .fstat-icon {
      width: 36px; height: 36px; border-radius: 8px;
      display: flex; align-items: center; justify-content: center; font-size: 1rem;
    }
    .fstat-icon.red-bg { background: rgba(232,25,44,0.1); }
    .fstat-icon.blue-bg { background: rgba(27,111,232,0.1); }
    .fstat-n { font-family: 'Fraunces', serif; font-weight: 900; font-size: 1.1rem; color: var(--dark-text); line-height: 1; }
    .fstat-l { font-size: 0.63rem; color: var(--mid-gray); font-weight: 600; margin-top: 2px; }

    /* ═══ SERVICE RIBBON ═══ */
    .service-ribbon {
      background: var(--navy);
      display: grid; grid-template-columns: repeat(4,1fr);
    }
    .ribbon-item {
      display: flex; flex-direction: column; align-items: center;
      text-align: center; padding: 26px 16px;
      border-right: 1px solid rgba(255,255,255,0.07);
      text-decoration: none;
      transition: background 0.25s;
      cursor: pointer;
    }
    .ribbon-item:last-child { border-right: none; }
    .ribbon-item:hover { background: rgba(27,111,232,0.15); }
    .ribbon-item:hover .r-circle { background: var(--blue); }
    .r-circle {
      width: 52px; height: 52px; border-radius: 50%;
      background: var(--blue); color: var(--white);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; margin-bottom: 10px;
      transition: background 0.25s;
      box-shadow: 0 4px 14px rgba(27,111,232,0.4);
    }
    .r-label { font-size: 0.68rem; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase; color: var(--white); }
    .r-sub { font-size: 0.63rem; color: rgba(255,255,255,0.45); margin-top: 3px; }

    /* ═══ STATS BAND ═══ */
    .stats-band {
      background: var(--white);
      border-top: 3px solid var(--red);
      border-bottom: 1px solid var(--border-light);
      display: grid; grid-template-columns: repeat(4,1fr);
    }
    .stat-cell {
      padding: 36px 20px; text-align: center;
      border-right: 1px solid var(--border-light);
      position: relative;
    }
    .stat-cell:last-child { border-right: none; }
    .stat-cell::before {
      content: '';
      position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
      width: 0; height: 2px; background: var(--red);
      transition: width 0.4s ease;
    }
    .stat-cell:hover::before { width: 60%; }
    .stat-cell:hover .stat-num { color: var(--red); }
    .stat-num {
      font-family: 'Fraunces', serif;
      font-size: 2.4rem; font-weight: 900; line-height: 1;
      color: var(--navy); transition: color 0.3s;
    }
    .stat-num sup { font-size: 1rem; vertical-align: super; }
    .stat-name { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.07em; text-transform: uppercase; color: var(--mid-gray); margin-top: 6px; }

    /* ═══ SECTION COMMONS ═══ */
    section { position: relative; }
    .eyebrow {
      display: inline-flex; align-items: center; gap: 8px;
      font-size: 0.68rem; font-weight: 800; letter-spacing: 0.12em;
      text-transform: uppercase; color: var(--red); margin-bottom: 12px;
    }
    .eyebrow::before {
      content: '';
      display: block; width: 20px; height: 2px; background: var(--red);
    }
    h2.sec-title {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.8rem, 3vw, 2.6rem);
      font-weight: 900; line-height: 1.15;
      color: var(--navy); letter-spacing: -0.02em;
    }
    h2.sec-title.light { color: var(--white); }
    .sec-desc { color: var(--mid-gray); font-size: 0.9rem; line-height: 1.75; max-width: 520px; margin-top: 12px; }
    .sec-desc.light { color: rgba(255,255,255,0.6); }

    /* ═══ SERVICES ═══ */
    #services { padding: 90px 5%; background: var(--off-white); }
    .svc-head { text-align: center; margin-bottom: 54px; }
    .svc-head .sec-desc { margin: 12px auto 0; }

    .svc-grid {
      display: grid; grid-template-columns: repeat(3,1fr);
      gap: 20px;
    }
    .svc-card {
      background: var(--white);
      border: 1px solid var(--border-light);
      border-radius: 12px; padding: 32px 28px;
      transition: all 0.3s;
      position: relative; overflow: hidden;
    }
    .svc-card::before {
      content: '';
      position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--red), var(--blue));
      transform: scaleX(0); transform-origin: left;
      transition: transform 0.4s ease;
    }
    .svc-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); border-color: transparent; }
    .svc-card:hover::before { transform: scaleX(1); }

    .svc-num { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--red); margin-bottom: 14px; }
    .svc-icon {
      width: 50px; height: 50px; border-radius: 10px;
      background: var(--off-white); border: 1px solid var(--border-light);
      display: flex; align-items: center; justify-content: center;
      font-size: 1.3rem; margin-bottom: 16px;
      transition: background 0.3s;
    }
    .svc-card:hover .svc-icon { background: rgba(27,111,232,0.08); border-color: rgba(27,111,232,0.2); }
    .svc-card h3 { font-size: 0.95rem; font-weight: 800; color: var(--navy); margin-bottom: 10px; line-height: 1.35; }
    .svc-card p { font-size: 0.82rem; color: var(--mid-gray); line-height: 1.7; }
    .svc-more {
      display: inline-flex; align-items: center; gap: 5px;
      color: var(--blue); font-size: 0.75rem; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      margin-top: 16px; text-decoration: none; transition: gap 0.2s;
    }
    .svc-more:hover { gap: 9px; }

    /* ═══ WHY US ═══ */
    #why { padding: 90px 5%; background: var(--white); }
    .why-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 72px; align-items: center; }

    .why-panel {
      background: var(--navy);
      border-radius: 14px; overflow: hidden;
      box-shadow: var(--shadow-lg);
    }
    .why-panel-top {
      background: var(--red);
      padding: 18px 26px;
      display: flex; align-items: center; gap: 10px;
    }
    .why-panel-top h3 { color: var(--white); font-size: 0.82rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; }
    .why-rows { }
    .why-row {
      display: flex; align-items: center; gap: 16px;
      padding: 18px 26px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
      transition: background 0.2s;
    }
    .why-row:last-child { border-bottom: none; }
    .why-row:hover { background: rgba(27,111,232,0.08); }
    .why-row-ico {
      width: 42px; height: 42px; flex-shrink: 0; border-radius: 9px;
      background: rgba(27,111,232,0.15);
      display: flex; align-items: center; justify-content: center; font-size: 1rem;
    }
    .why-row-val { font-family: 'Fraunces', serif; font-size: 1.6rem; font-weight: 900; color: var(--white); line-height: 1; }
    .why-row-lbl { font-size: 0.72rem; color: rgba(255,255,255,0.5); margin-top: 2px; font-weight: 500; }

    .why-features { display: flex; flex-direction: column; gap: 14px; }
    .why-feat {
      display: flex; gap: 14px; align-items: flex-start;
      padding: 20px; border-radius: 10px;
      background: var(--off-white); border: 1px solid var(--border-light);
      transition: all 0.25s;
    }
    .why-feat:hover { border-color: rgba(27,111,232,0.3); background: rgba(27,111,232,0.04); box-shadow: var(--shadow-sm); }
    .feat-ico {
      width: 40px; height: 40px; flex-shrink: 0; border-radius: 9px;
      background: rgba(232,25,44,0.08); border: 1px solid rgba(232,25,44,0.15);
      display: flex; align-items: center; justify-content: center; font-size: 1rem;
    }
    .why-feat h4 { font-size: 0.875rem; font-weight: 800; color: var(--navy); margin-bottom: 4px; }
    .why-feat p { font-size: 0.78rem; color: var(--mid-gray); line-height: 1.65; }

    /* ═══ PROCESS ═══ */
    #process {
      padding: 90px 5%;
      background: var(--navy-dark);
      text-align: center;
    }
    .process-grid {
      display: grid; grid-template-columns: repeat(4,1fr);
      gap: 0; margin-top: 52px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px; overflow: hidden;
    }
    .proc-step {
      padding: 40px 24px;
      border-right: 1px solid rgba(255,255,255,0.08);
      transition: background 0.3s;
      position: relative;
    }
    .proc-step:last-child { border-right: none; }
    .proc-step:hover { background: rgba(27,111,232,0.1); }
    .proc-step:hover .step-n { background: var(--blue); }
    .step-n {
      width: 54px; height: 54px; border-radius: 50%;
      background: var(--red); color: var(--white);
      font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 900;
      display: flex; align-items: center; justify-content: center;
      margin: 0 auto 18px;
      box-shadow: 0 6px 20px rgba(232,25,44,0.35);
      transition: background 0.3s;
    }
    .proc-step h3 { font-size: 0.875rem; font-weight: 800; color: var(--white); margin-bottom: 10px; }
    .proc-step p { font-size: 0.78rem; color: rgba(255,255,255,0.5); line-height: 1.7; }

    /* ═══ TESTIMONIALS ═══ */
    #reviews { padding: 90px 5%; background: var(--off-white); }
    .rev-head { margin-bottom: 52px; }
    .rev-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; }
    .rev-card {
      background: var(--white); border: 1px solid var(--border-light);
      border-radius: 12px; padding: 28px;
      transition: all 0.3s;
    }
    .rev-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: rgba(27,111,232,0.2); }
    .rev-stars { color: #F59E0B; font-size: 0.85rem; margin-bottom: 12px; }
    .rev-open-quote {
      font-family: 'Fraunces', serif;
      font-size: 3rem; color: var(--red); line-height: 0.8;
      margin-bottom: 8px; display: block;
    }
    .rev-text { font-size: 0.83rem; color: #4B5563; line-height: 1.75; font-style: italic; margin-bottom: 18px; }
    .rev-author { display: flex; align-items: center; gap: 10px; }
    .rev-avatar {
      width: 38px; height: 38px; border-radius: 50%; flex-shrink: 0;
      background: linear-gradient(135deg, var(--red), var(--blue));
      display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.75rem; color: var(--white);
    }
    .rev-name { font-size: 0.82rem; font-weight: 800; color: var(--navy); }
    .rev-loc { font-size: 0.7rem; color: var(--mid-gray); margin-top: 1px; }

    /* ═══ AREAS ═══ */
    #areas {
      padding: 60px 5%;
      background: var(--white);
      border-top: 1px solid var(--border-light);
    }
    .areas-inner { text-align: center; }
    .areas-title { font-size: 0.78rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: var(--mid-gray); margin-bottom: 20px; }
    .areas-tags { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
    .area-tag {
      display: flex; align-items: center; gap: 6px;
      background: var(--off-white); border: 1px solid var(--border-light);
      color: var(--navy); padding: 7px 14px; border-radius: 5px;
      font-size: 0.78rem; font-weight: 600; transition: all 0.2s;
    }
    .area-tag:hover { background: rgba(27,46,94,0.06); border-color: rgba(27,46,94,0.2); }
    .area-dot { width: 5px; height: 5px; border-radius: 50%; background: var(--blue); }

    /* ═══ AI CHAT ═══ */
    #ai-chat {
      padding: 90px 5%;
      background: var(--navy-dark);
      text-align: center;
    }
    .chat-shell {
      max-width: 680px; margin: 52px auto 0;
      border-radius: 14px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(0,0,0,0.5);
      border: 1px solid rgba(255,255,255,0.08);
    }
    .chat-bar {
      background: var(--navy);
      padding: 15px 22px;
      display: flex; align-items: center; gap: 12px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .chat-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--red); display: flex; align-items: center; justify-content: center;
      font-weight: 800; font-size: 0.75rem; color: var(--white); flex-shrink: 0;
    }
    .chat-bar-info h4 { font-size: 0.85rem; font-weight: 700; color: var(--white); }
    .chat-bar-info p { font-size: 0.7rem; color: rgba(255,255,255,0.4); }
    .chat-online { margin-left: auto; display: flex; align-items: center; gap: 5px; font-size: 0.68rem; font-weight: 600; color: #4ADE80; }
    .online-dot { width: 6px; height: 6px; border-radius: 50%; background: #4ADE80; animation: blink 2s infinite; }

    .chat-msgs {
      background: rgba(13,27,62,0.8);
      height: 320px; overflow-y: auto;
      padding: 18px; display: flex; flex-direction: column; gap: 12px;
    }
    .chat-msgs::-webkit-scrollbar { width: 3px; }
    .chat-msgs::-webkit-scrollbar-thumb { background: var(--blue); border-radius: 2px; }

    .m { max-width: 82%; font-size: 0.84rem; line-height: 1.65; padding: 11px 15px; border-radius: 10px; animation: fadeUp 0.35s ease both; }
    .m.bot { background: var(--navy); border: 1px solid rgba(255,255,255,0.07); align-self: flex-start; border-bottom-left-radius: 3px; color: rgba(255,255,255,0.85); }
    .m.usr { background: var(--blue); color: var(--white); align-self: flex-end; border-bottom-right-radius: 3px; font-weight: 500; }
    .m.typing { opacity: 0.55; font-style: italic; }

    .chat-quick-wrap {
      background: var(--navy); border-top: 1px solid rgba(255,255,255,0.06);
      padding: 10px 18px; display: flex; flex-wrap: wrap; gap: 7px;
    }
    .qc {
      background: transparent;
      border: 1px solid rgba(27,111,232,0.35);
      color: #7DB8FF; padding: 5px 11px; border-radius: 4px;
      font-size: 0.7rem; font-weight: 600; cursor: pointer;
      transition: all 0.2s; font-family: 'Plus Jakarta Sans', sans-serif;
    }
    .qc:hover { background: rgba(27,111,232,0.15); border-color: var(--blue); color: var(--white); }

    .chat-input-row {
      background: var(--navy);
      border-top: 1px solid rgba(255,255,255,0.06);
      padding: 13px 18px;
      display: flex; gap: 10px;
    }
    .chat-field {
      flex: 1; background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 7px; padding: 10px 15px;
      color: var(--white); font-family: 'Plus Jakarta Sans', sans-serif;
      font-size: 0.82rem; outline: none; transition: border-color 0.2s;
    }
    .chat-field::placeholder { color: rgba(255,255,255,0.25); }
    .chat-field:focus { border-color: var(--blue); }
    .chat-send-btn {
      background: var(--red); color: var(--white);
      border: none; border-radius: 7px;
      padding: 10px 18px; font-weight: 800; font-size: 0.78rem;
      letter-spacing: 0.04em; text-transform: uppercase;
      cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif;
      transition: all 0.2s;
    }
    .chat-send-btn:hover { background: var(--red-dark); }
    .chat-send-btn:disabled { opacity: 0.4; cursor: not-allowed; }

    /* ═══ FAQ ═══ */
    #faq { padding: 90px 5%; background: var(--white); }
    .faq-layout { display: grid; grid-template-columns: 1fr 1.6fr; gap: 80px; align-items: start; }
    .faq-list { display: flex; flex-direction: column; gap: 6px; }
    .faq-item {
      border: 1px solid var(--border-light);
      border-radius: 8px; overflow: hidden;
      background: var(--off-white);
    }
    .faq-q {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 20px; cursor: pointer;
      font-size: 0.85rem; font-weight: 700; color: var(--navy);
      transition: color 0.2s; user-select: none;
    }
    .faq-q:hover { color: var(--blue); }
    .faq-icon {
      width: 26px; height: 26px; border-radius: 50%; flex-shrink: 0;
      background: rgba(27,46,94,0.08);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.65rem; color: var(--navy);
      transition: all 0.3s;
    }
    .faq-item.open .faq-icon { background: var(--red); color: var(--white); transform: rotate(180deg); }
    .faq-a {
      max-height: 0; overflow: hidden;
      font-size: 0.82rem; color: var(--mid-gray); line-height: 1.7;
      transition: max-height 0.35s ease, padding 0.35s;
      padding: 0 20px;
    }
    .faq-item.open .faq-a { max-height: 220px; padding: 0 20px 16px; }

    /* ═══ CTA BANNER ═══ */
    #cta-band {
      background: var(--red);
      padding: 80px 5%; text-align: center;
      position: relative; overflow: hidden;
    }
    #cta-band::before {
      content: '';
      position: absolute; inset: 0;
      background: repeating-linear-gradient(-45deg, rgba(0,0,0,0.04) 0, rgba(0,0,0,0.04) 1px, transparent 1px, transparent 16px);
      pointer-events: none;
    }
    #cta-band h2 {
      font-family: 'Fraunces', serif;
      font-size: clamp(1.9rem, 4vw, 3rem);
      font-weight: 900; color: var(--white); position: relative; z-index: 1;
    }
    #cta-band p { color: rgba(255,255,255,0.8); max-width: 480px; margin: 12px auto 32px; font-size: 0.9rem; position: relative; z-index: 1; }
    .cta-band-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; position: relative; z-index: 1; }
    .btn-wh {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--white); color: var(--red);
      padding: 14px 30px; border-radius: 7px;
      font-weight: 800; font-size: 0.88rem; letter-spacing: 0.04em;
      text-decoration: none; text-transform: uppercase;
      transition: all 0.25s;
    }
    .btn-wh:hover { transform: translateY(-2px); box-shadow: 0 14px 36px rgba(0,0,0,0.25); }
    .btn-nv {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--navy-dark); color: var(--white);
      padding: 14px 30px; border-radius: 7px;
      font-weight: 700; font-size: 0.88rem; letter-spacing: 0.04em;
      text-decoration: none; text-transform: uppercase;
      transition: all 0.25s;
    }
    .btn-nv:hover { background: var(--navy); transform: translateY(-2px); }
    .cta-phones {
      display: flex; gap: 12px; justify-content: center; flex-wrap: wrap;
      margin-top: 24px; position: relative; z-index: 1;
    }
    .ph-chip {
      display: flex; align-items: center; gap: 7px;
      background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.3);
      color: var(--white); padding: 9px 18px; border-radius: 6px;
      text-decoration: none; font-weight: 700; font-size: 0.83rem;
      transition: background 0.2s;
    }
    .ph-chip:hover { background: rgba(255,255,255,0.28); }

    /* ═══ FOOTER ═══ */
    footer {
      background: var(--navy-deeper);
      border-top: 3px solid var(--red);
      padding: 60px 5% 28px;
    }
    .footer-top {
      display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px; padding-bottom: 48px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }
    .foot-brand-name {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800; font-size: 1.35rem; letter-spacing: -0.01em;
    }
    .foot-brand-name .fn-home { color: var(--white); }
    .foot-brand-name .fn-check { color: var(--red); }
    .foot-brand-name .fn-in { color: var(--white); }
    .foot-tag { font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-top: 2px; }
    .foot-about { font-size: 0.78rem; color: rgba(255,255,255,0.4); line-height: 1.75; margin-top: 14px; }
    .foot-addr { font-size: 0.73rem; color: rgba(255,255,255,0.28); margin-top: 12px; line-height: 1.65; }
    .foot-col h5 { font-size: 0.65rem; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.3); margin-bottom: 14px; }
    .foot-col ul { list-style: none; display: flex; flex-direction: column; gap: 9px; }
    .foot-col a { font-size: 0.78rem; color: rgba(255,255,255,0.48); text-decoration: none; transition: color 0.2s; }
    .foot-col a:hover { color: var(--blue-light); }
    .footer-bottom {
      padding-top: 22px;
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;
    }
    .footer-bottom p { font-size: 0.72rem; color: rgba(255,255,255,0.22); }
    .foot-socials { display: flex; gap: 8px; }
    .soc-btn {
      width: 32px; height: 32px; border-radius: 6px;
      background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08);
      display: flex; align-items: center; justify-content: center;
      color: rgba(255,255,255,0.38); font-size: 0.78rem;
      text-decoration: none; transition: all 0.2s;
    }
    .soc-btn:hover { background: var(--red); border-color: var(--red); color: var(--white); }

    /* ═══ WHATSAPP ═══ */
    .wa {
      position: fixed; bottom: 26px; right: 26px; z-index: 600;
      width: 56px; height: 56px; border-radius: 50%;
      background: #25D366;
      display: flex; align-items: center; justify-content: center;
      box-shadow: 0 6px 24px rgba(37,211,102,0.5);
      text-decoration: none; color: var(--white);
      transition: transform 0.25s, box-shadow 0.25s;
      animation: popIn 0.7s 1.8s ease both;
    }
    .wa:hover { transform: scale(1.1); box-shadow: 0 10px 32px rgba(37,211,102,0.6); }
    @keyframes popIn { from{opacity:0;transform:scale(0)} 80%{transform:scale(1.1)} to{opacity:1;transform:scale(1)} }

    /* ═══ ANIMATIONS ═══ */
    @keyframes fadeUp { from{opacity:0;transform:translateY(22px)} to{opacity:1;transform:none} }
    .reveal { opacity:0; transform:translateY(22px); transition: opacity 0.55s ease, transform 0.55s ease; }
    .reveal.in { opacity:1; transform:none; }

    /* ═══ RESPONSIVE ═══ */
    @media(max-width:1100px) {
      .svc-grid { grid-template-columns: repeat(2,1fr); }
      .why-grid { grid-template-columns: 1fr; gap: 40px; }
      .footer-top { grid-template-columns: 1fr 1fr; }
    }
    @media(max-width:900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-visual { display: none; }
      .process-grid { grid-template-columns: repeat(2,1fr); }
    }
    @media(max-width:700px) {
      .topbar { font-size: 0.65rem; }
      .nav-menu, .nav-phone { display: none; }
      .service-ribbon { grid-template-columns: repeat(2,1fr); }
      .stats-band { grid-template-columns: repeat(2,1fr); }
      .svc-grid { grid-template-columns: 1fr; }
      .rev-grid { grid-template-columns: 1fr; }
      .faq-layout { grid-template-columns: 1fr; gap: 40px; }
      .footer-top { grid-template-columns: 1fr; }
      .hero-content { padding: 70px 5% 60px; }
    }
  </style>
</head>
<body>

