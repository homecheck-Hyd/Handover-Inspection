<!-- ══ PROCESS ══ -->
<section id="process" aria-labelledby="process-heading">
  <div class="reveal">
    <span class="eyebrow" style="color:rgba(255,255,255,0.5);border:none;padding:0">How It Works</span>
    <h2 class="sec-title light" id="process-heading">Get Inspected in 4 Simple Steps</h2>
    <p class="sec-desc light">Fast, professional, and completely hassle-free — from booking to builder-ready report.</p>
  </div>
  <div class="process-grid" role="list">
    <div class="proc-step reveal" role="listitem">
      <div class="step-n" aria-label="Step 1">1</div>
      <h3>Book Online or Call</h3>
      <p>Fill the request form or call us. We confirm a convenient date and time for your property inspection.</p>
    </div>
    <div class="proc-step reveal" role="listitem">
      <div class="step-n" aria-label="Step 2">2</div>
      <h3>On-Site Inspection</h3>
      <p>Our certified civil engineer visits and conducts a 250+ point check using professional tools and thermal cameras.</p>
    </div>
    <div class="proc-step reveal" role="listitem">
      <div class="step-n" aria-label="Step 3">3</div>
      <h3>Report in 48 Hours</h3>
      <p>A comprehensive photo-documented PDF report is emailed within 48 hours — clear, actionable, and builder-ready.</p>
    </div>
    <div class="proc-step reveal" role="listitem">
      <div class="step-n" aria-label="Step 4">4</div>
      <h3>Get Corrections Done</h3>
      <p>Present the report to your builder, get all defects fixed. Book a re-inspection to confirm every issue is resolved.</p>
    </div>
  </div>
</section>

